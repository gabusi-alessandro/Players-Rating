# ============================================================
#  Visualizzazione del vincolo Lq e curve di livello tangenti
#  sum_j |beta_j|^q <= t,  con q >= 0
# ============================================================
#
#  Il grafico mostra:
#   - Regione ammissibile (pallina Lq) in blu
#   - 3 curve di livello della funzione di perdita OLS di cui
#     la più esterna è quella tangente al vincolo
#   - Punto di tangenza (stima vincolata) in verde
#   - Minimo non vincolato (beta_hat) in arancio
#
#  Pacchetti necessari: ggplot2, patchwork
# ============================================================
if (!requireNamespace("ggplot2",   quietly = TRUE)) install.packages("ggplot2")
if (!requireNamespace("patchwork", quietly = TRUE)) install.packages("patchwork")
library(ggplot2)
library(patchwork)
# ── 1. PARAMETRI GLOBALI ─────────────────────────────────────
# Raggio della pallina Lq  (|beta_1|^q + |beta_2|^q <= t)
t_radius <- 1.0
# Minimo non vincolato della perdita OLS:  beta_hat = (b1_hat, b2_hat)
b1_hat <-  1.6
b2_hat <-  1.2
# Matrice di covarianza per gli ellissoidi OLS  (X'X  in forma ridotta)
# Regola la forma e l'inclinazione delle ellissi
A11 <- 2.5
A22 <- 1.5
A12 <- 0.6   # termine di correlazione
# ── 2. FUNZIONI AUSILIARIE ───────────────────────────────────
# Perdita OLS  L(β) = (β - β_hat)' A (β - β_hat)
ols_loss <- function(b1, b2) {
d1 <- b1 - b1_hat
d2 <- b2 - b2_hat
A11 * d1^2 + 2 * A12 * d1 * d2 + A22 * d2^2
}
# Curva del vincolo Lq: |b1|^q + |b2|^q = t
# Restituisce un data.frame (x, y) che parametrizza il contorno
lq_boundary <- function(q, t = t_radius, n = 2000) {
if (q == 0) {
# L0: vertici ai 4 punti cardinali (approssimazione visiva: quadrato orientato)
# Il "ball" L0 = { (b1,b2) : # nonzero <= t }  —  per t=1 sono i due assi
return(data.frame(
x = c(-t,  0,  t,  0, -t),
y = c( 0,  t,  0, -t,  0)
))
}
theta <- seq(0, 2 * pi, length.out = n + 1)
if (q >= 50) {
# Linf: quadrato
x <- cos(theta)
y <- sin(theta)
scale <- pmax(abs(x), abs(y))
return(data.frame(x = t * x / scale, y = t * y / scale))
}
# Formula generale:  |cos(theta)|^(2/q) + |sin(theta)|^(2/q) = 1  (in forma "super-ellisse")
# Percorriamo il cerchio unitario e scaliamo al raggio Lq
ct <- cos(theta)
st <- sin(theta)
# Norma Lq del punto (cos, sin)
lq_norm <- (abs(ct)^q + abs(st)^q)^(1 / q)
x <- t * ct / lq_norm
y <- t * st / lq_norm
data.frame(x = x, y = y)
}
# Trova il punto sulla frontiera Lq che minimizza la perdita OLS
# usando ottimizzazione numerica sul parametro angolare theta
find_tangent_point <- function(q, t = t_radius) {
if (q == 0) {
# Casi degeneri: asse b1 o b2
loss_b1 <- ols_loss(t, 0)
loss_m1 <- ols_loss(-t, 0)
loss_b2 <- ols_loss(0, t)
loss_m2 <- ols_loss(0, -t)
idx <- which.min(c(loss_b1, loss_m1, loss_b2, loss_m2))
pts <- list(c(t,0), c(-t,0), c(0,t), c(0,-t))
return(pts[[idx]])
}
obj <- function(theta) {
ct <- cos(theta); st <- sin(theta)
lqn <- (abs(ct)^q + abs(st)^q)^(1/q)
b1 <- t * ct / lqn
b2 <- t * st / lqn
ols_loss(b1, b2)
}
# Griglia grossolana per trovare un buon punto di partenza
theta_grid <- seq(0, 2*pi, length.out = 500)
losses     <- sapply(theta_grid, obj)
theta0     <- theta_grid[which.min(losses)]
res <- optim(theta0, obj, method = "Brent",
lower = theta0 - 0.5, upper = theta0 + 0.5,
control = list(tol = 1e-10))
theta_star <- res$par
ct <- cos(theta_star); st <- sin(theta_star)
lqn <- (abs(ct)^q + abs(st)^q)^(1/q)
c(t * ct / lqn, t * st / lqn)
}
# ── 3. FUNZIONE PRINCIPALE DI PLOT ──────────────────────────
make_lq_plot <- function(q, t = t_radius, axis_lim = 2.2,
title_suffix = "") {
# --- Frontiera Lq ---
bnd  <- lq_boundary(q, t)
poly <- bnd  # poligono chiuso per il riempimento
# --- Punto di tangenza ---
tp   <- find_tangent_point(q, t)
tp_df <- data.frame(x = tp[1], y = tp[2])
# --- Valore della perdita al punto di tangenza ---
L_tangent <- ols_loss(tp[1], tp[2])
# Tre livelli: più interno (0.35*L_t), intermedio (0.65*L_t), esterno = L_tangent
levels_inner <- c(0.25 * L_tangent, 0.55 * L_tangent)
# --- Dati per le tre ellissi di livello ---
theta_ell <- seq(0, 2*pi, length.out = 500)
make_ellipse <- function(level) {
# Ellissoide  (β - β_hat)' A (β - β_hat) = level
# Decomponiamo A per estrarre la cholesky e parametrizzare
# A = [[A11, A12],[A12, A22]]
# Cholesky:  L = [[l11, 0],[l21, l22]]
l11 <- sqrt(A11)
l21 <- A12 / l11
l22 <- sqrt(A22 - l21^2)
# Cerchio unitario scalato:  z = sqrt(level) * [cos, sin]
# β - β_hat = L^{-T} z
# L^{-T} = inv(L)'  =  [[1/l11, -l21/(l11*l22)],[0, 1/l22]]
z1 <- sqrt(level) * cos(theta_ell)
z2 <- sqrt(level) * sin(theta_ell)
b1 <- b1_hat + z1 / l11 - z2 * l21 / (l11 * l22)
b2 <- b2_hat + z2 / l22
data.frame(x = b1, y = b2, level = factor(round(level, 4)))
}
ell_inner1 <- make_ellipse(levels_inner[1])
ell_inner2 <- make_ellipse(levels_inner[2])
ell_outer  <- make_ellipse(L_tangent)
# ---- Unconstrained minimum point ----
ols_df <- data.frame(x = b1_hat, y = b2_hat)
# ---- Label per il valore di q ----
if (q == Inf) {
q_label <- "q = \u221e (L\u221e)"
} else if (q == 0) {
q_label <- "q = 0 (L\u2080)"
} else {
q_label <- paste0("q = ", q)
}
ggplot() +
# Regione ammissibile (fill)
geom_polygon(data = poly,
aes(x = x, y = y),
fill = "#3B82F6", alpha = 0.20, colour = NA) +
# Frontiera Lq
geom_path(data = bnd,
aes(x = x, y = y),
colour = "#1D4ED8", linewidth = 0.9) +
# Curve di livello interne (tratteggiate)
geom_path(data = ell_inner1,
aes(x = x, y = y),
colour = "#DC2626", linewidth = 0.7, linetype = "dashed") +
geom_path(data = ell_inner2,
aes(x = x, y = y),
colour = "#DC2626", linewidth = 0.7, linetype = "dashed") +
# Curva di livello tangente (continue, più spessa)
geom_path(data = ell_outer,
aes(x = x, y = y),
colour = "#DC2626", linewidth = 1.1, linetype = "solid") +
# Punto di tangenza
geom_point(data = tp_df,
aes(x = x, y = y),
colour = "#16A34A", size = 3.5, shape = 21,
fill = "#4ADE80", stroke = 1.5) +
# Minimo OLS non vincolato
geom_point(data = ols_df,
aes(x = x, y = y),
colour = "#EA580C", size = 3.5, shape = 24,
fill = "#FB923C", stroke = 1.5) +
# Assi cartesiani
geom_hline(yintercept = 0, colour = "grey40", linewidth = 0.4) +
geom_vline(xintercept = 0, colour = "grey40", linewidth = 0.4) +
# Annotazione punto di tangenza
annotate("text",
x = tp[1] + 0.12, y = tp[2] + 0.14,
label = expression(hat(beta)[constr.]),
colour = "#16A34A", size = 3.2, hjust = 0) +
# Annotazione minimo OLS
annotate("text",
x = b1_hat + 0.10, y = b2_hat + 0.14,
label = expression(hat(beta)[OLS]),
colour = "#EA580C", size = 3.2, hjust = 0) +
coord_fixed(xlim = c(-axis_lim, axis_lim),
ylim = c(-axis_lim, axis_lim)) +
scale_x_continuous(breaks = seq(-2, 2, by = 1)) +
scale_y_continuous(breaks = seq(-2, 2, by = 1)) +
labs(
title    = bquote(bold("Vincolo " ~ L[q] ~ "e curve di livello OLS") ~ " — " ~ .(q_label)),
subtitle = bquote(sum(abs(beta[j])^q, j==1, p) <= .(t_radius) ~
"   (blu = regione ammissibile)"),
x        = expression(beta[1]),
y        = expression(beta[2])
) +
theme_minimal(base_size = 13) +
theme(
plot.title    = element_text(face = "bold", size = 13),
plot.subtitle = element_text(colour = "grey40", size = 9.5),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(colour = "grey88", linewidth = 0.35),
axis.title    = element_text(size = 11)
)
}
# ── 4. PLOT SINGOLO (q scelto dall'utente) ──────────────────
q_single <- 1   # <-- MODIFICA QUI per cambiare il valore di q
#     (es.: 0.5 = subquadratico, 1 = LASSO, 2 = Ridge, Inf = L-inf)
p_single <- make_lq_plot(q_single)
print(p_single)
# ── 5. PANNELLO COMPARATIVO  q = 0.5 | 1 | 2 | 4 ───────────
p_03 <- make_lq_plot(0.3) + labs(title = 'q = 0.3')
p_05 <- make_lq_plot(0.5) + labs(title = "q = 0.5")
p_1  <- make_lq_plot(1)   + labs(title = "q = 1  (LASSO)")
p_12 <- make_lq_plot(1.2) + labd(title = 'q = 1.2')
p_12 <- make_lq_plot(1.2) + labs(title = 'q = 1.2')
p_2  <- make_lq_plot(2)   + labs(title = "q = 2  (Ridge)")
p_4  <- make_lq_plot(4)   + labs(title = "q = 4")
comparison <- (p_05 | p_1) / (p_2 | p_4) +
plot_annotation(
title    = expression(bold("Confronto dei vincoli " ~ L[q])),
subtitle = "Le curve tratteg. rosse toccano la frontiera Lq nel punto di minimo vincolato",
theme    = theme(plot.title    = element_text(face = "bold", size = 15),
plot.subtitle = element_text(colour = "grey40"))
)
print(comparison)
comparison <- (p_03 | p_05 | p_1 ) / (p_12 |p_2 | p_4) +
plot_annotation(
title    = expression(bold("Confronto dei vincoli " ~ L[q])),
subtitle = "Le curve tratteg. rosse toccano la frontiera Lq nel punto di minimo vincolato",
theme    = theme(plot.title    = element_text(face = "bold", size = 15),
plot.subtitle = element_text(colour = "grey40"))
)
print(comparison)
comparison <- (p_03 | p_05 | p_1 ) / (p_12 |p_2 | p_4) +
plot_annotation(
title    = expression(bold("Confronto dei vincoli " ~ L[q])),
subtitle = "Le curve continue rosse toccano la frontiera Lq nel punto di minimo vincolato",
theme    = theme(plot.title    = element_text(face = "bold", size = 15),
plot.subtitle = element_text(colour = "grey40"))
)
print(comparison)
library(ggplot2)
# 1. Definizione della griglia per le curve di livello dell'RSS
b1_seq <- seq(-2, 2.5, length.out = 300)
b2_seq <- seq(-2, 2.5, length.out = 300)
grid <- expand.grid(beta1 = b1_seq, beta2 = b2_seq)
# Coordinate della stima OLS (centro delle ellissi)
b1_ols <- 1.4
b2_ols <- 0.2
# Calcolo della funzione di perdita quadratica (crea ellissi ruotate)
grid$loss <- (grid$beta1 - b1_ols)^2 + 2.2 * (grid$beta2 - b2_ols)^2 - 1.5 * (grid$beta1 - b1_ols) * (grid$beta2 - b2_ols)
# 2. Funzione per generare il grafico al variare di q
plot_regularization <- function(q_val = 1, c_radius = 1) {
# Parametrizzazione della frontiera |b1|^q + |b2|^q = c
angles <- seq(0, 2 * pi, length.out = 1000)
cos_t <- cos(angles)
sin_t <- sin(angles)
# Trick matematico per gestire qualsiasi q >= 0 senza numeri complessi
b1_bound <- c_radius * sign(cos_t) * (abs(cos_t))^(2 / q_val)
b2_bound <- c_radius * sign(sin_t) * (abs(sin_t))^(2 / q_val)
df_constraint <- data.frame(beta1 = b1_bound, beta2 = b2_bound)
# Titolo dinamico in base al valore di q
nome_norma <- switch(
as.character(q_val),
"1" = " (Lasso - Norma L1)",
"2" = " (Ridge - Norma L2)",
"0.5" = " (Non-convesso - q < 1)",
""
)
ggplot() +
# Area del vincolo (riempimento blu)
geom_polygon(data = df_constraint, aes(x = beta1, y = beta2),
fill = "#3B82F6", alpha = 0.25, color = "#1D4ED8", linewidth = 1) +
# Curve di livello RSS (ellissi rosse)
geom_contour(data = grid, aes(x = beta1, y = beta2, z = loss),
color = "#EF4444", bins = 15, linewidth = 0.6) +
# Punto OLS (Unconstrained Estimate)
annotate("point", x = b1_ols, y = b2_ols, color = "#B91C1C", size = 3) +
annotate("text", x = b1_ols + 0.35, y = b2_ols + 0.1,
label = expression(hat(beta)[OLS]), color = "#B91C1C", size = 4.5) +
# Assi cartesiani
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
# Formattazione estetica
coord_fixed(xlim = c(-1.8, 2.2), ylim = c(-1.8, 2.2)) +
labs(
title = paste0("Vincolo con q = ", q_val, nome_norma),
subtitle = expression(paste("Soluzione nel punto di tangenza tra RSS e ", sum(abs(beta[j])^q, j==1, p) <= c)),
x = expression(beta[1]),
y = expression(beta[2])
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
}
# 3. Esempi di generazione dei grafici:
# Lasso (q = 1)
plot_regularization(q_val = 1, c_radius = 1)
# Ridge (q = 2)
plot_regularization(q_val = 2, c_radius = 1)
# Non-convesso / Sparsità forte (q = 0.5)
plot_regularization(q_val = 0.5, c_radius = 1)
# Lasso (q = 1)
plot_regularization(q_val = 1, c_radius = 1)
# Ridge (q = 2)
plot_regularization(q_val = 2, c_radius = 1)
